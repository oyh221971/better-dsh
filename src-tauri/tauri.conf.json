{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Better DSH",
    "version":  "0.1.0",
    "identifier":  "com.betterdsh.desktop",
    "build":  {
                  "beforeDevCommand":  "pnpm dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "pnpm build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "Better DSH",
                                    "width":  1100,
                                    "height":  720,
                                    "minWidth":  820,
                                    "minHeight":  560,
                                    "center":  true,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "msi"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}